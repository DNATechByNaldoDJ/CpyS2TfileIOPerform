        jSplitPath:=dna.tech.fileTools():SplitPath(cFile)
        cFileTarget:=cTempPath
        cFileTarget+=jSplitPath["file"]
        cFileTarget+=jSplitPath["ext"]
        FreeObj(@jSplitPath)
        jPerformCopy["FileSizeCopy"]:=dna.tech.fileTools():FileSize(cFileTarget)
    endif

    jPerformCopy["TimeProcEnd"]:=Time()
    jPerformCopy["ProcEnd"]:=TimeCounter()

    __SendToLogger(oFileLogger,jPerformCopy,1)

return

static procedure __TST_CPYS2TZip(oFileLogger as object,jFile as json,jPerformCopy as json)

    local cFile:=jFile["File"] as character
    local cTempPath:=GetTempPath()+ProcName()+"\" as character
    local cFileTarget

    local jSplitPath as json

    local lCpyS2T as logical

    FWMakeDir(cTempPath,.F.)

    jPerformCopy["ProcStart"]:=TimeCounter()
    jPerformCopy["TimeProcStart"]:=Time()

    lCpyS2T:=CPYS2T(cFile,cTempPath,.T.)
    jPerformCopy["CpyS2T"]:=lCpyS2T
    if (lCpyS2T)
        jSplitPath:=dna.tech.fileTools():SplitPath(cFile)
        cFileTarget:=cTempPath
        cFileTarget+=jSplitPath["file"]
        cFileTarget+=jSplitPath["ext"]
        FreeObj(@jSplitPath)
        jPerformCopy["FileSizeCopy"]:=dna.tech.fileTools():FileSize(cFileTarget)
    endif

    jPerformCopy["TimeProcEnd"]:=Time()
    jPerformCopy["ProcEnd"]:=TimeCounter()

    __SendToLogger(oFileLogger,jPerformCopy,1)

return

static procedure __TST_GETDATAFROMSERVERWITHZIP(oFileLogger as object,jPerformCopy as json,n1MB as numeric)

    local aFiles as array

    local bNotSendData as codeblock

    local cZipKey as character
    local cErrorMsg as character
    local cTempPath:=GetTempPath()+ProcName()+"\" as character
    local cTargetPath:=StrTran(__SYSTEM_ROTULOS_PATH__,"\\",BACK_SLASH) as character

    local lCpyS2T as logical

    local nFile as numeric
    local nFiles as numeric
    local nSizeFiles as numeric

    FWMakeDir(cTempPath,.F.)

    jPerformCopy["ProcStart"]:=TimeCounter()
    jPerformCopy["TimeProcStart"]:=Time()

    cZipKey:=dna.tech.BraidedEncrypt():GenPWD(15)
    bNotSendData:={|cPathFile,cType,aData|FilterZipData(cPathFile,cType,aData,cTargetPath,n1MB)}
    lCpyS2T:=dna.tech.fileTools():GetDataFromServerWithZip(cTargetPath,cTempPath,bNotSendData,@cErrorMsg,@cZipKey)
    jPerformCopy["CpyS2T"]:=lCpyS2T

    jPerformCopy["TimeProcEnd"]:=Time()
    jPerformCopy["ProcEnd"]:=TimeCounter()

    if (lCpyS2T)
        aFiles:=Directory(cTempPath+"*.*")
        nFiles:=Len(aFiles)
        nSizeFiles:=0
        for nFile:=1 to nFiles
            nSizeFiles+=aFiles[nFile][F_SIZE]
        next nFile
        FWFreeArray(@aFiles)
        jPerformCopy["FileSizeCopy"]:=nSizeFiles
    endif

    __SendToLogger(oFileLogger,jPerformCopy,1)

return

static function FilterZipData(cPathFile as character,cType as character,aData as array,cTargetPath as character,n1MB as numeric) as logical
    local lNotSendData:=.F. as logical
    if (cType=="D")
        lNotSendData:=(cPathFile!=cTargetPath)
    elseif (cType=="A")
        lNotSendData:=(aData[F_SIZE]<n1MB)
    endif
return(lNotSendData)
